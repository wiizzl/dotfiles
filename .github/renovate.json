{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 4am on monday"],
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Base image of each variant, pinned by digest",
      "managerFilePatterns": ["/^image/[^/]+/base(-[^/]+)?$/"],
      "matchStrings": [
        "^(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "New builds of the same base tag",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "description": "GitHub Actions updates within the same major version",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}
