[user]
	email = "{{ .git_email }}"
	name = "{{ .git_name }}"
	signingkey = ~/.ssh/allowed_signers

[gpg]
  format = "ssh"

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgSign = true
	sort = -version:refname

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[branch]
	sort = -committerdate

[url "git@github.com:"]
	insteadOf = gh:

[url "git@gitlab.com:"]
	insteadOf = gl:

[url "git@github.com:{{ .github_username }}/"]
	insteadOf = me: