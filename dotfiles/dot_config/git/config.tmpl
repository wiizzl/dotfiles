[user]
{{- with get . "git_name" }}
	name = {{ . | quote }}
{{- end }}
{{- with get . "git_email" }}
	email = {{ . | quote }}
{{- end }}
{{- with get . "git_signing_key" }}
	signingkey = {{ if hasPrefix "key::" . }}{{ . | quote }}{{ else }}{{ printf "key::%s" . | quote }}{{ end }}

[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = "~/.config/git/allowed_signers"

[commit]
	gpgsign = true

[tag]
	gpgSign = true
{{- end }}

[init]
	defaultBranch = "main"

[core]
	autocrlf = "input"

[column]
	ui = "auto"

[branch]
	sort = "-committerdate"

[tag]
	sort = "version:refname"

[commit]
	verbose = true

[status]
	showUntrackedFiles = "all"

[diff]
	algorithm = "histogram"
	colorMoved = "plain"
	mnemonicPrefix = true
	renames = true

[merge]
	conflictStyle = "zdiff3"

[rerere]
	enabled = true
	autoupdate = true

[fetch]
	prune = true

[pull]
	rebase = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[push]
	autoSetupRemote = true
	followTags = true

[help]
	autocorrect = "prompt"

[url "git@github.com:"]
	insteadOf = gh:

[url "git@gitlab.com:"]
	insteadOf = gl:
